DATABASE_URL="postgresql://test_insights:test_insights_dev@localhost:5432/test_insights?schema=public"
API_PORT=3001
# Optional bind address, e.g. 127.0.0.1 behind a reverse proxy.
API_HOST=
CORS_ORIGIN="http://localhost:5173"
ENABLE_LEGACY_IMPORT=false
TRUST_PROXY=false
# Where attachments extracted from allure-results archives are stored.
# Default: api/storage/attachments. Content-addressed files.
ATTACHMENTS_DIR=
# Attachment retention: the API deletes files older than this many hours on an
# hourly sweep (and once at startup). A value <= 0 is ignored and 48 is used, so
# an accidental zero cannot wipe the directory. Also used by
# `npm run attachments:gc` and `db:verify`.
ATTACHMENT_TTL_HOURS=
# Set to false when an external cron runs `attachments:gc` instead of the API.
ATTACHMENT_GC_ENABLED=true
# Maximum size of one uploaded allure-results archive in bytes (default 512 MiB).
ALLURE_IMPORT_MAX_BYTES=
