generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Environment {
  test
  stage
  production
}

enum TestStatus {
  passed
  failed
  skipped
  running
}

model Phase {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(200)
  environment Environment
  startedAt   DateTime      @db.Date
  endedAt     DateTime      @db.Date
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  reports     Report[]
  results     TestResult[]

  @@index([createdAt])
}

model Report {
  id        String       @id @default(cuid()) @db.VarChar(30)
  phaseId   Int
  name      String       @db.VarChar(200)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  author    String       @default("You") @db.VarChar(120)
  phase     Phase        @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  results   TestResult[]

  @@index([phaseId, createdAt])
}

model TestResult {
  id              String     @id @default(cuid()) @db.VarChar(30)
  phaseId         Int
  reportId        String     @db.VarChar(30)
  automatedTestId String     @db.VarChar(200)
  name            String     @db.VarChar(300)
  status          TestStatus
  duration        Int        @default(0)
  lastRunAt       DateTime   @default(now()) @db.Timestamptz(3)
  errorMessage    String?
  steps           Json       @default("[]") @db.JsonB
  phase           Phase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  report          Report     @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, automatedTestId])
  @@index([phaseId, reportId])
}
