generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Environment {
  test
  stage
  production
}

// Values reported by the automation system.
enum TestStatus {
  passed
  failed
  broken
  skipped
}

model Phase {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(200)
  environment Environment
  startedAt   DateTime      @db.Date
  endedAt     DateTime      @db.Date
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  reports     Report[]

  @@index([createdAt])
}

model Report {
  id        String   @id @default(cuid()) @db.VarChar(30)
  phaseId   Int
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  author    String   @default("You") @db.VarChar(120)
  phase     Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId, createdAt])
}

// Catalog of automated tests, imported from the JSON file contract or harvested
// from stored runs. `resultPath` is the key that links a run to its definition.
model AutomatedTest {
  id                 String   @id @default(cuid()) @db.VarChar(30)
  resultPath         String   @unique @db.VarChar(300)
  display            String   @db.VarChar(300)
  fullResponsibility String?  @db.VarChar(200)
  defaultSuiteName   String?  @db.VarChar(200)
  defaultCaseName    String?  @db.VarChar(300)
  defaultOwner       String?  @db.VarChar(120)
  tags               Json     @default("[]") @db.JsonB
  visible            Boolean  @default(true)
  source             String   @default("manual") @db.VarChar(30)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

// One run of an automated test, as posted by the automation system.
// Runs are not bound to a report row: a report shows the runs whose
// [startDate, endDate] window covers the report date.
model TestResult {
  id        String     @id @default(cuid()) @db.VarChar(30)
  path      String     @db.VarChar(300)
  suiteName String?    @db.VarChar(200)
  caseName  String?    @db.VarChar(300)
  status    TestStatus
  owner     String?    @db.VarChar(120)
  circuit   String?    @db.VarChar(120)
  message   String?
  startDate DateTime   @db.Timestamptz(3)
  endDate   DateTime   @db.Timestamptz(3)
  tags      Json       @default("[]") @db.JsonB
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  @@index([path, startDate])
  @@index([startDate, endDate])
}
