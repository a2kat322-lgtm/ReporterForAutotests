generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Values reported by the automation system.
enum TestStatus {
  passed
  failed
  broken
  skipped
}

// A workspace isolates phases, reports, catalog entries and runs for one
// project. Its name is the `projectName` the automation system posts.
model Workspace {
  id        BigInt   @id @default(autoincrement())
  /// Canonical form: lowercase and whitespace-trimmed; matches TestResult.projectName.
  name      String   @unique @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  phases    Phase[]
  tests     AutomatedTest[]
  runs      TestResult[]

  @@index([createdAt])
}

model Phase {
  id          BigInt        @id @default(autoincrement())
  workspaceId BigInt
  name        String        @db.VarChar(200)
  /// Canonical form: lowercase and whitespace-trimmed (enforced by a CHECK constraint).
  environment String
  startedAt   DateTime      @db.Date
  endedAt     DateTime      @db.Date
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reports     Report[]

  @@index([createdAt])
  @@index([workspaceId])
}

model Report {
  id        BigInt   @id @default(autoincrement())
  phaseId   BigInt
  name      String   @db.VarChar(200)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  author    String   @default("You") @db.VarChar(120)
  phase     Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([phaseId, name])
  @@index([phaseId, createdAt])
  @@index([phaseId, startDate, endDate])
}

// Catalog of automated tests. `resultPath` is a unique business key, not a row ID.
model AutomatedTest {
  id                 BigInt   @id @default(autoincrement())
  workspaceId        BigInt
  resultPath         String   @db.VarChar(300)
  // Environments explicitly associated with this test by Harvest.
  environments       AutomatedTestEnvironment[]
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fullResponsibility String?  @db.VarChar(200)
  defaultSuiteName   String?  @db.VarChar(200)
  defaultCaseName    String?  @db.VarChar(300)
  defaultOwner       String?  @db.VarChar(120)
  tags               Json     @default("[]") @db.JsonB
  visible            Boolean  @default(true)
  source             String   @default("manual") @db.VarChar(30)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, resultPath])
}

// Canonical environment names are lowercase; composite PK prevents duplicates.
model AutomatedTestEnvironment {
  automatedTestId BigInt
  environment     String        @db.Text
  automatedTest   AutomatedTest @relation(fields: [automatedTestId], references: [id], onDelete: Cascade)

  @@id([automatedTestId, environment])
  @@index([environment])
}

// One run of an automated test, as posted by the automation system.
// Runs are not bound to a report row: a report shows runs whose
// [startDate, endDate] window overlaps its inclusive [startDate, endDate] period.
model TestResult {
  id        BigInt     @id @default(autoincrement())
  workspaceId BigInt
  /// Canonical form of the `projectName` the automation system posted; lowercased and trimmed.
  projectName String   @db.VarChar(200)
  /// Matches `AutomatedTest.resultPath`. Logical join (no FK): uncatalogued runs are allowed.
  path      String     @db.VarChar(300)
  suiteName String?    @db.VarChar(200)
  caseName  String?    @db.VarChar(300)
  status    TestStatus
  /// Allure `labels.epic` — the top level of the behaviour hierarchy, used by report filters.
  epic      String?    @db.VarChar(200)
  owner     String?    @db.VarChar(120)
  /// Canonical form: lowercase (enforced by a CHECK constraint). Compared against Phase.environment.
  circuit   String?    @db.VarChar(120)
  failureReason  String?    @db.VarChar(120)
  failureComment String?
  startDate      DateTime   @db.Timestamptz(3)
  endDate   DateTime   @db.Timestamptz(3)
  tags      Json       @default("[]") @db.JsonB
  /// Allure result `uuid`: makes repeated imports of the same archive idempotent.
  externalId String? @db.VarChar(128)
  /// Import batch (one uploaded archive) — groups all runs of a single CI execution.
  launchId   String? @db.VarChar(128)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  detail    TestResultDetail?

  @@unique([workspaceId, externalId])
  @@index([workspaceId, path, startDate])
  @@index([workspaceId, startDate, endDate])
  /// `startDate` is part of the key so a circuit filter can also use a date range.
  @@index([workspaceId, circuit, startDate])
  @@index([workspaceId, launchId])
}

/// Cold part of a run: the failure text and the Allure detail. It lives in its
/// own table so the hot run row stays narrow — reports and analytics read
/// thousands of runs per request, while these columns are read for one run at a
/// time by the detail drawer (and for failed runs by the failure analytics).
model TestResultDetail {
  resultId      BigInt      @id
  /// Failure text posted by the automation system or imported from Allure.
  message       String?
  /// Nested step tree imported from `allure-results` (name, status, timings, nested steps, attachments).
  /// Stays `[]` for runs posted through the form contract.
  steps         Json        @default("[]") @db.JsonB
  /// Attachment metadata (`name`, `type`, `size`, `key`); the file itself lives in the attachment storage.
  attachments   Json        @default("[]") @db.JsonB
  /// Parameters of a parametrised run: `[{ name, value, excluded }]`.
  parameters    Json        @default("[]") @db.JsonB
  /// Links from Allure (`@TmsLink`, `@Issue`, `@Link`): `[{ name, url, type }]`.
  links         Json        @default("[]") @db.JsonB
  /// `{ message, trace, known, muted, flaky }` from Allure `statusDetails`.
  statusDetails Json?       @db.JsonB

  result TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
}
