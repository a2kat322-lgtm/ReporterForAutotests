generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Values reported by the automation system.
enum TestStatus {
  passed
  failed
  broken
  skipped
}

// A workspace isolates phases, reports, catalog entries and runs for one
// project. Its name is the `projectName` the automation system posts.
model Workspace {
  id        BigInt   @id @default(autoincrement())
  /// Canonical form: lowercase and whitespace-trimmed; matches TestResult.projectName.
  name      String   @unique @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  phases    Phase[]
  tests     AutomatedTest[]
  runs      TestResult[]

  @@index([createdAt])
}

model Phase {
  id          BigInt        @id @default(autoincrement())
  workspaceId BigInt
  name        String        @db.VarChar(200)
  /// Canonical form: lowercase and whitespace-trimmed (enforced by a CHECK constraint).
  environment String
  startedAt   DateTime      @db.Date
  endedAt     DateTime      @db.Date
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reports     Report[]

  @@index([createdAt])
  @@index([workspaceId])
}

model Report {
  id        BigInt   @id @default(autoincrement())
  phaseId   BigInt
  name      String   @db.VarChar(200)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  author    String   @default("You") @db.VarChar(120)
  phase     Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([phaseId, name])
  @@index([phaseId, createdAt])
  @@index([phaseId, startDate, endDate])
}

// Catalog of automated tests. `resultPath` is a unique business key, not a row ID.
model AutomatedTest {
  id                 BigInt   @id @default(autoincrement())
  workspaceId        BigInt
  resultPath         String   @db.VarChar(300)
  // Environments explicitly associated with this test by Harvest.
  environments       AutomatedTestEnvironment[]
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fullResponsibility String?  @db.VarChar(200)
  defaultSuiteName   String?  @db.VarChar(200)
  defaultCaseName    String?  @db.VarChar(300)
  defaultOwner       String?  @db.VarChar(120)
  tags               Json     @default("[]") @db.JsonB
  visible            Boolean  @default(true)
  source             String   @default("manual") @db.VarChar(30)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, resultPath])
}

// Canonical environment names are lowercase; composite PK prevents duplicates.
model AutomatedTestEnvironment {
  automatedTestId BigInt
  environment     String        @db.Text
  automatedTest   AutomatedTest @relation(fields: [automatedTestId], references: [id], onDelete: Cascade)

  @@id([automatedTestId, environment])
  @@index([environment])
}

// One run of an automated test, as posted by the automation system.
// Runs are not bound to a report row: a report shows runs whose
// [startDate, endDate] window overlaps its inclusive [startDate, endDate] period.
model TestResult {
  id        BigInt     @id @default(autoincrement())
  workspaceId BigInt
  /// Canonical form of the `projectName` the automation system posted; lowercased and trimmed.
  projectName String   @db.VarChar(200)
  /// Matches `AutomatedTest.resultPath`. Logical join (no FK): uncatalogued runs are allowed.
  path      String     @db.VarChar(300)
  suiteName String?    @db.VarChar(200)
  caseName  String?    @db.VarChar(300)
  status    TestStatus
  owner     String?    @db.VarChar(120)
  /// Canonical form: lowercase (enforced by a CHECK constraint). Compared against Phase.environment.
  circuit   String?    @db.VarChar(120)
  message        String?
  failureReason  String?    @db.VarChar(120)
  failureComment String?
  startDate      DateTime   @db.Timestamptz(3)
  endDate   DateTime   @db.Timestamptz(3)
  tags      Json       @default("[]") @db.JsonB
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, path, startDate])
  @@index([workspaceId, startDate, endDate])
  @@index([workspaceId, circuit])
}
