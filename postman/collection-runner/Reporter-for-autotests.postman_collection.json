                  "  function (error) {",
                  "    if (error) console.error('[reporter] ' + error.message)",
                  "  },",
                  ")"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"hello\":\"reporter\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/post"
          },
          "response": []
        }
      ]
    },
