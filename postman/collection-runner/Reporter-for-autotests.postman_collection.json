    {
      "key": "baseUrl",
      "value": "https://postman-echo.com",
      "type": "string"
    },
    {
      "key": "reporterUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "reporterProject",
      "value": "cwi",
      "type": "string"
    },
    {
      "key": "reporterEnvironment",
      "value": "dso",
      "type": "string"
    },
    {
      "key": "reporterCollection",
      "value": "Reporter Demo API",
      "type": "string"
    },
    {
      "key": "reporterOwner",
      "value": "qa",
      "type": "string"
    },
    {
      "key": "reporterTags",
      "value": "postman,ui",
      "type": "string"
    },
    {
      "key": "reporterOrigin",
      "value": "local",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Smoke",
      "description": "Два проходящих запроса: показывают passed в отчёте.",
      "item": [
        {
          "name": "GET echo",
          "description": "Проверяет GET и отправляет строку в Reporter for autotests.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Reporter for autotests: helper и отправка строки отчёта.",
                  "// Проверки пишите через check(), блоки не удаляйте.",
                  "const reporterChecks = []",
                  "let reporterTotal = 0",
                  "",
                  "function check(name, fn) {",
                  "  reporterTotal += 1",
                  "  pm.test(name, function () {",
                  "    try {",
                  "      fn()",
                  "    } catch (error) {",
                  "      reporterChecks.push(name + ': ' + error.message)",
                  "      throw error",
                  "    }",
                  "  })",
                  "}",
                  "",
                  "// ---- проверки ----",
                  "check('status 200', function () { pm.response.to.have.status(200) })",
                  "check('query echoed', function () { pm.expect(pm.response.json().args.name).to.eql('reporter') })",
                  "",
                  "const reporterVariable = function (name, fallback) {",
                  "  return pm.variables.get(name) || fallback",
                  "}",
                  "const reporterCode = pm.response && pm.response.code",
                  "const reporterEnd = Date.now()",
                  "const reporterStatus = !reporterCode",
                  "  ? 'broken'",
                  "  : reporterChecks.length || (reporterTotal === 0 && reporterCode >= 400)",
                  "    ? 'failed'",
                  "    : 'passed'",
                  "const reporterEndpoint = reporterVariable('reporterUrl', 'http://localhost:3001').replace(/\\/$/, '')",
                  "",
                  "pm.sendRequest(",
                  "  {",
                  "    url: reporterEndpoint + '/api/results',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "      mode: 'raw',",
                  "      raw: JSON.stringify({",
                  "        projectName: reporterVariable('reporterProject', 'default'),",
                  "        path: reporterVariable('reporterCollection', 'Postman') + '#' + pm.info.requestName,",
                  "        caseName: pm.info.requestName,",
                  "        status: reporterStatus,",
                  "        circuit: reporterVariable('reporterEnvironment', 'local'),",
                  "        owner: reporterVariable('reporterOwner', '') || undefined,",
                  "        message: !reporterCode",
                  "          ? 'request failed: no response'",
                  "          : reporterChecks.join('; ') || ' ',",
                  "        startDate: new Date(reporterEnd - ((pm.response && pm.response.responseTime) || 0)).toISOString(),",
                  "        endDate: new Date(reporterEnd).toISOString(),",
                  "        tag: reporterVariable('reporterTags', '')",
                  "          .split(',')",
                  "          .map(function (tag) { return tag.trim() })",
                  "          .filter(Boolean),",
                  "      }),",
                  "    },",
                  "  },",
                  "  function (error) {",
                  "    if (error) console.error('[reporter] ' + error.message)",
                  "  },",
                  ")"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/get?name=reporter"
          },
          "response": []
        },
        {
